# Contraseña del panel del reclutador (/admin). Obligatoria en producción.
ADMIN_PASSWORD=cambia-esta-clave
# Nombre que ven los candidatos
COMPANY_NAME=Mi Empresa
# Zona horaria de las entrevistas
TIME_ZONE=America/Santiago
# Código de país para números sin "+" (56 = Chile)
DEFAULT_COUNTRY_CODE=56
# URL pública de la app, para los links que se envían por WhatsApp (ej: https://postula.miempresa.cl)
PUBLIC_URL=
# Carpeta donde se guardan la base de datos y los CV
DATA_DIR=data
MAX_CV_MB=5
PORT=3100
